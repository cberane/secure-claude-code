#!/usr/bin/env bash
# commit-msg hook (container-side, via core.hooksPath) — enforces:
#   1. No AI attribution of any kind in commit messages.
#   2. Conventional Commits format: type(scope): subject, subject <= 72 chars.
set -u

MSG_FILE="$1"
# Ignore comment lines when checking content.
msg="$(grep -v '^#' "$MSG_FILE" || true)"
subject="$(printf '%s\n' "$msg" | sed -n '1p')"

fail() {
    cat >&2 <<EOF

┌─ COMMIT MESSAGE REJECTED ─────────────────────────────
│ $1
│
│ Rules:
│   * No Co-Authored-By trailers, no "Generated with",
│     no tool attribution, no emojis.
│   * Conventional Commits: type(scope): subject
│     types: feat fix docs style refactor perf test build ci chore revert
│   * Subject line <= 72 characters, imperative mood.
└───────────────────────────────────────────────────────
EOF
    exit 1
}

# --- 1. attribution / trailer ban ----------------------------------------
if printf '%s\n' "$msg" | grep -qiE 'co-authored-by'; then
    fail "Contains a Co-Authored-By trailer."
fi
if printf '%s\n' "$msg" | grep -qiE 'generated with|generated by'; then
    fail 'Contains a "Generated with/by" attribution line.'
fi
if printf '%s\n' "$msg" | grep -qi 'noreply@anthropic.com'; then
    fail "Contains an anthropic.com noreply address."
fi
if printf '%s\n' "$msg" | grep -q '🤖'; then
    fail "Contains the 🤖 emoji."
fi

# --- 2. Conventional Commits ---------------------------------------------
# Merge/revert commits generated by git itself and fixup/squash commits pass.
case "$subject" in
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -qE \
    '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: [^ ].*$'; then
    fail "Subject does not follow 'type(scope): subject': $subject"
fi

if [ "${#subject}" -gt 72 ]; then
    fail "Subject line is ${#subject} characters (max 72)."
fi

exit 0
