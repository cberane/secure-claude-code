# Copy to .env and adjust. .env is gitignored — never commit it.

# Container engine: docker | podman
ENGINE=docker

# REQUIRED: absolute host path of the project directory mounted at /workspace.
# This is the ONLY writable bind mount the container gets.
PROJECTS_DIR=/home/you/projects/my-project

# Host UID/GID so files created in /workspace belong to you, not root.
# Find yours with: id -u / id -g
UID=1000
GID=1000

# Git identity used for commits made inside the container.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Authentication — pick ONE:
#  a) Leave empty and run `claude /login` once inside `make claude`
#     (OAuth token persists in the claude-config volume), or
#  b) Set an API key here.
ANTHROPIC_API_KEY=

# Optional model override, e.g. claude-sonnet-5
ANTHROPIC_MODEL=

# Build target: runtime (slim) | dev-php (adds php-cli + composer)
BUILD_TARGET=runtime

# Resource limits
MEM_LIMIT=4g
CPUS=2
PIDS_LIMIT=512
NOFILE=4096
TMP_SIZE=512m

# Signing-key rotation policy (age computed from key.meta created_at)
SIGNING_KEY_WARN_DAYS=30
SIGNING_KEY_MAX_DAYS=45
# Escape hatch: set to false to turn the MAX_DAYS pre-commit abort into a
# warning. Do NOT leave this off permanently.
SIGNING_KEY_ENFORCE=true
