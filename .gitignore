# Secrets — never commit key material or credentials
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
*.key
*.pem
id_*
*.p12
*.pfx

# Local, per-machine egress policy (created from egress/allowlist.template.txt)
egress/allowlist.txt

# Local, per-machine compose tweaks (see docker-compose.override.example.yml)
docker-compose.override.yml

# Egress learning-mode marker (make learn / make learn-off)
.learning-mode

# Local state — but project skills are shared and tracked
.claude/*
!.claude/skills/
*.log
tmp/

# Local, per-machine dind image-pull policy (created from dind/images-allowlist.template.txt)
dind/images-allowlist.txt

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
